generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          Int    @id @default(autoincrement())
  name        String @default("Оксана")
  lastName    String @default("Лапа")
  email       String @default("oksana.lapa@example.com") @unique
  description String?
}

model Gallery {
  id       Int      @id @default(autoincrement())
  title    String
  category String
  description String 
  price    Int
  status   String[] @default([])
  is_tall  Boolean
  image    String
  year     Int
}

model News {
  id Int @id @default(autoincrement())
  title String?
  status String[] @default([])
  category String
  description String?
  date DateTime?
}

enum Role {
  ADMIN
  GUEST
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(GUEST)
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? 
  access_token       String? 
  expires_at         Int?    
  token_type         String? 
  scope              String? 
  id_token           String? 
  session_state      String? 

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

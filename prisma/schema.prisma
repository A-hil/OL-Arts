generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          Int    @id @default(autoincrement())
  name        String @default("Оксана")
  lastName    String @default("Лапа")
  email       String @default("oksana.lapa@example.com") @unique
  description String?
}

model Gallery {
  id       Int      @id @default(autoincrement())
  title    String
  category String
  description String 
  price    Int
  status   String[] @default([])
  is_tall  Boolean
  image    String
  year     Int
}

model News {
  id Int @id @default(autoincrement())
  title String?
  status String[] @default([])
  category String
  description String?
  date DateTime?
}
